#!/bin/bash
#PBS -N gmm_as
#PBS -P gs_ccds_haidang.dau
#PBS -q gpu_as
#PBS -l walltime=6:00:00
#PBS -l select=1:ncpus=12:ngpus=1:mem=32gb
#PBS -j oe

DIMS=(3) # (2 3)
SEEDS=(0) # (0 1)
KS=(2) # (10 20)
NPROC=$(( ${#DIMS[@]} * ${#SEEDS[@]} * ${#KS[@]} ))
THREADS=$(( 12 / NPROC > 0 ? 12 / NPROC : 1 ))

cd "${PBS_O_WORKDIR}" || exit 1
mkdir -p logs
export PYTHONUNBUFFERED=1

# --- Correctif officiel PBS/GaaS pour les identifiants GPU (inchangé) ---
if echo "${CUDA_VISIBLE_DEVICES:-}" | grep -q "GPU-"; then
    GPU_COUNT=$(echo "${CUDA_VISIBLE_DEVICES}" | tr ',' '\n' | wc -l)
    CUDA_VISIBLE_DEVICES=$(seq -s, 0 $((GPU_COUNT - 1)))
    export CUDA_VISIBLE_DEVICES
fi

# 12 CPU répartis entre les processus
export OMP_NUM_THREADS=${THREADS}
export MKL_NUM_THREADS=${THREADS}

module purge
module load anaconda/2025
eval "$(/usr/local/anaconda2025/bin/conda shell.bash hook)"
conda activate BMS

echo "Nœud : $(hostname) à $(date)"
nvidia-smi -L

# Suivi de l'utilisation du GPU toutes les 30 s
nvidia-smi --query-gpu=timestamp,utilization.gpu,memory.used --format=csv -l 30 > logs/gpu_usage_as.csv &
MON=$!

pids=()
for K in "${KS[@]}"; do
  for DIM in "${DIMS[@]}"; do
    for SEED in "${SEEDS[@]}"; do
      echo "Lancement GMM K=${K} dim=${DIM} seed=${SEED}"
      python train.py experiment=gmm_as dim=${DIM} seed=${SEED} K=${K} \
          fast_sampling=true buffer_on_device=true \
          hydra.run.dir=results/gmm_as/K${K}_dim${DIM}_seed${SEED} \
          > logs/as_K${K}_dim${DIM}_seed${SEED}.log 2>&1 &
      pids+=($!)
    done
  done
done

# Attend chaque processus et garde la trace des échecs
fail=0
for p in "${pids[@]}"; do wait "$p" || fail=1; done
kill $MON 2>/dev/null
echo "Fin à $(date), statut : ${fail}"
exit $fail