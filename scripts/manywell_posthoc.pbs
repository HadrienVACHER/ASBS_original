#!/bin/bash
#PBS -N manywell_posthoc
#PBS -P gs_ccds_haidang.dau
#PBS -q gpu_as
#PBS -l walltime=01:30:00
#PBS -l select=1:ncpus=3:ngpus=1:mem=16gb
#PBS -j oe

# APRÈS la phase 2 (manywell_corr.pbs) : (1) qualité du MODÈLE : ESS de Girsanov et erreur sur log Z pour AS et Barker (AS + post-hoc = le modèle AS) ;
# (2) baselines POST-HOC sur les échantillons finaux de AS à budget d'énergie apparié (reweight BAR + MCMC orbite) et tableau des proportions de toutes les méthodes.
# Lancer avec : qsub -v COMMIT=<hash court du run Barker de la phase 2> scripts/manywell_posthoc.pbs
cd "${PBS_O_WORKDIR}" || exit 1
mkdir -p logs
export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1

# --- Correctif officiel PBS/GaaS pour les identifiants GPU (inchangé) ---
if echo "${CUDA_VISIBLE_DEVICES:-}" | grep -q "GPU-"; then
    GPU_COUNT=$(echo "${CUDA_VISIBLE_DEVICES}" | tr ',' '\n' | wc -l)
    CUDA_VISIBLE_DEVICES=$(seq -s, 0 $((GPU_COUNT - 1)))
    export CUDA_VISIBLE_DEVICES
fi

module purge
module load anaconda/2025
eval "$(/usr/local/anaconda2025/bin/conda shell.bash hook)"
conda activate BMS

echo "Nœud : $(hostname) à $(date)"
nvidia-smi -L
git log --oneline -1

R=results
python scripts/manywell_model_quality.py --experiment manywell_corr_as --controller ${R}/manywell_corr_as/seed0/controller_final.pt --label AS || exit 1
python scripts/manywell_model_quality.py --experiment manywell_corr_barker --controller ${R}/manywell_corr_barker/seed0/controller_final.pt --label Barker || exit 1
python scripts/manywell_posthoc.py --init ${R}/manywell_pretrain/seed0/samples_final.pt --as-samples ${R}/manywell_corr_as/seed0/samples_final.pt \
    --barker-samples ${R}/manywell_corr_barker/seed0/samples_final.pt --barker-commit ${COMMIT} || exit 1
fail=0
echo "Fin à $(date), statut : ${fail}"
exit $fail
