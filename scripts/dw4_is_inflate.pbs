#!/bin/bash
#PBS -N dw4_is_inflate
#PBS -P gs_ccds_haidang.dau
#PBS -q gpu_as
#PBS -l walltime=00:30:00
#PBS -l select=1:ncpus=6:ngpus=1:mem=16gb
#PBS -j oe

# DW-4, IS / IMH post hoc sur les endpoints avec une proposition englobante (hors ligne, CPU, rapport seul).
# Règle pré-enregistrée dans l'en-tête de scripts/dw4_is_inflate.py ; paramètres EM : scripts/dw4_division_trunc_params.json
# (coordonnées liées à la base eigh de la machine : à exécuter sur le cluster uniquement).
# Le cluster n'accepte que des jobs GPU : 1 GPU demandé, non utilisé (le script est CPU).
cd "${PBS_O_WORKDIR}" || exit 1
export PYTHONUNBUFFERED=1 OMP_NUM_THREADS=6
module purge
module load anaconda/2025
eval "$(/usr/local/anaconda2025/bin/conda shell.bash hook)"
conda activate BMS
git log --oneline -1
python scripts/dw4_is_inflate.py
