#!/bin/bash
#PBS -N gmm_as_barker_pinned
#PBS -P gs_ccds_haidang.dau
#PBS -q gpu_as
#PBS -l walltime=06:00:00
#PBS -l select=1:ncpus=6:ngpus=1:mem=24gb
#PBS -j oe

# À lancer depuis la branche mh (AdjointVEBarkerMatcher). Barker (défauts de gmm_as_barker : gamma = 1, M = K,
# orbite complète de M - 1 translates) sur la config des 3 runs AS épinglés (vzwfvmh3, aueiibuw, rqt970vx) :
# K = d = 12, 24, 36, seed 0, 2000 epochs, rayon 4.25, rapport de poids 20, mêmes options fast_*.
# Référence AS (mode_tv / eff_modes_ratio) : d12 0.0347/0.976, d24 0.0966/0.884, d36 0.119/0.824.
# MH (gmm{d}d_as_mh_head, même config, déjà dans W&B) : d12 0.0205/0.981, d24 0.0631/0.871, d36 0.109/0.847.
# Coût : M - 1 = K - 1 évaluations d'énergie par échantillon (11 / 23 / 35), contre < 1 pour MH.
DIMS=(12 24 36)
SEED=0
EPOCHS=2000
NPROC=${#DIMS[@]}
THREADS=$(( 6 / NPROC > 0 ? 6 / NPROC : 1 ))

cd "${PBS_O_WORKDIR}" || exit 1
mkdir -p logs
export PYTHONUNBUFFERED=1

# --- Correctif officiel PBS/GaaS pour les identifiants GPU (inchangé) ---
if echo "${CUDA_VISIBLE_DEVICES:-}" | grep -q "GPU-"; then
    GPU_COUNT=$(echo "${CUDA_VISIBLE_DEVICES}" | tr ',' '\n' | wc -l)
    CUDA_VISIBLE_DEVICES=$(seq -s, 0 $((GPU_COUNT - 1)))
    export CUDA_VISIBLE_DEVICES
fi

export OMP_NUM_THREADS=${THREADS}
export MKL_NUM_THREADS=${THREADS}

module purge
module load anaconda/2025
eval "$(/usr/local/anaconda2025/bin/conda shell.bash hook)"
conda activate BMS

echo "Nœud : $(hostname) à $(date)"
nvidia-smi -L
git log --oneline -1

pids=()
for DIM in "${DIMS[@]}"; do
  echo "Lancement Barker K=${DIM} dim=${DIM} seed=${SEED}"
  python train.py experiment=gmm_as_barker dim=${DIM} K=${DIM} seed=${SEED} num_epochs=${EPOCHS} \
      fast_sampling=true buffer_on_device=true fast_train=true \
      exp_name=gmm${DIM}d_as_barker_head \
      hydra.run.dir=results/gmm_as_barker_pinned/K${DIM}_dim${DIM}_seed${SEED} \
      > logs/barker_pinned_K${DIM}_dim${DIM}_seed${SEED}.log 2>&1 &
  pids+=($!)
done

# Attend chaque processus et garde la trace des échecs
fail=0
for p in "${pids[@]}"; do wait "$p" || fail=1; done
echo "Fin à $(date), statut : ${fail}"
exit $fail
