#!/bin/bash
#PBS -N dw4_div_trunc_eval
#PBS -P gs_ccds_haidang.dau
#PBS -q gpu_as
#PBS -l walltime=02:00:00
#PBS -l select=1:ncpus=6:ngpus=1:mem=16gb
#PBS -j oe

# DW-4 division, étape 1' (évaluation) : tests unitaires puis k_hat des composantes tronquées ; règle pré-enregistrée dans l'en-tête de scripts/dw4_division_trunc.py, paramètres commités avant ce job.
# Le cluster n'accepte que des jobs GPU : 1 GPU demandé, non utilisé (le script est CPU).
# Échantillons AS : run ed8bb67 UNIQUEMENT (results/dw4_as_states_e1500/seed0/samples_final.pt est le run 94252 : ne pas l'utiliser).
cd "${PBS_O_WORKDIR}" || exit 1
export PYTHONUNBUFFERED=1 OMP_NUM_THREADS=6
module purge
module load anaconda/2025
eval "$(/usr/local/anaconda2025/bin/conda shell.bash hook)"
conda activate BMS
git log --oneline -1
S=results/dw4_e1500_ed8bb67_samples.pt
[ -f "$S" ] || { echo "manque $S"; exit 1; }
echo "échantillons AS : $S"
# les paramètres commités doivent être identiques au fichier écrit par le job de préparation (transcription vérifiée)
if [ -f dw4_division_trunc_params.json ]; then
python - <<'PY'
import json, numpy as np, sys
a, b = json.load(open("scripts/dw4_division_trunc_params.json")), json.load(open("dw4_division_trunc_params.json"))
ok = a.keys() == b.keys() and all(a[k]["c"] == b[k]["c"] and a[k]["eta"] == b[k]["eta"] and np.allclose(a[k]["mu"], b[k]["mu"], rtol=0, atol=1e-12) and np.allclose(a[k]["Sigma"], b[k]["Sigma"], rtol=0, atol=1e-12) for k in a)
print("paramètres commités == fichier du job de préparation :", ok)
sys.exit(0 if ok else 1)
PY
[ $? -eq 0 ] || exit 1
fi
python scripts/dw4_division_trunc.py --stage eval --samples "$S"
