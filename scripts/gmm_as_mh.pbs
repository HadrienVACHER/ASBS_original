#!/bin/bash
#PBS -N gmm_as_mh
#PBS -P gs_ccds_haidang.dau
#PBS -q gpu_as
#PBS -l walltime=18:00:00
#PBS -l select=1:ncpus=12:ngpus=1:mem=32gb
#PBS -j oe

# Metropolis-Hastings control variate (AdjointVEMHMatcher), defaults of gmm_as_mh: gamma = 2, M = 2K, one jump.
# K = d modes, all DIMS and VARIANTS in one job:  qsub scripts/gmm_as_mh.pbs
# k-means on x1 + ∇log p1(x1) (denoise_step = 1): finds the light modes that raw k-means misses at d >= 24.
DIMS=(12 24 36)
SEEDS=(0) # training seeds; the target is fixed by target_seed
EPOCHS=5000
# AS and MH at 5000 epochs already exist (16 Oct 09:29 / 09:58); this job adds:
#   mh_ema     MH, evaluation with an EMA of the controller (0.999 per step)
#   mh_emabuf  MH, EMA controller also generates the buffer
#   mh_g4      MH with gamma = 4
#   mh_big     MH, controller 256 channels x 6 layers (capacity)
#   as_big     AS, same bigger controller (is the light-mode deficit a capacity limit?)
VARIANTS=(mh_ema mh_emabuf mh_g4 mh_big as_big)
BIG="controller.channels=256 controller.num_layers=6"
NPROC=$(( ${#DIMS[@]} * ${#SEEDS[@]} * ${#VARIANTS[@]} ))
THREADS=$(( 12 / NPROC > 0 ? 12 / NPROC : 1 ))

cd "${PBS_O_WORKDIR}" || exit 1
mkdir -p logs
export PYTHONUNBUFFERED=1

# --- Correctif officiel PBS/GaaS pour les identifiants GPU (inchangé) ---
if echo "${CUDA_VISIBLE_DEVICES:-}" | grep -q "GPU-"; then
    GPU_COUNT=$(echo "${CUDA_VISIBLE_DEVICES}" | tr ',' '\n' | wc -l)
    CUDA_VISIBLE_DEVICES=$(seq -s, 0 $((GPU_COUNT - 1)))
    export CUDA_VISIBLE_DEVICES
fi

# 12 CPU répartis entre les processus
export OMP_NUM_THREADS=${THREADS}
export MKL_NUM_THREADS=${THREADS}

module purge
module load anaconda/2025
eval "$(/usr/local/anaconda2025/bin/conda shell.bash hook)"
conda activate BMS

echo "Nœud : $(hostname) à $(date)"
nvidia-smi -L

# Suivi de l'utilisation du GPU toutes les 30 s
nvidia-smi --query-gpu=timestamp,utilization.gpu,memory.used --format=csv -l 30 > logs/gpu_usage_as_mh.csv &
MON=$!

pids=()
for DIM in "${DIMS[@]}"; do
  K=${DIM}
  for SEED in "${SEEDS[@]}"; do
    for V in "${VARIANTS[@]}"; do
      case ${V} in
        as)        ARGS="experiment=gmm_as" ;;
        mh)        ARGS="experiment=gmm_as_mh" ;;
        mh_ema)    ARGS="experiment=gmm_as_mh ema_decay=0.999 exp_name=gmm${DIM}d_as_mh_ema" ;;
        mh_emabuf) ARGS="experiment=gmm_as_mh ema_decay=0.999 ema_buffer=true exp_name=gmm${DIM}d_as_mh_emabuf" ;;
        mh_g4)     ARGS="experiment=gmm_as_mh adjoint_matcher.gamma=4" ;;
        mh_big)    ARGS="experiment=gmm_as_mh ${BIG} exp_name=gmm${DIM}d_as_mh_big" ;;
        as_big)    ARGS="experiment=gmm_as ${BIG} exp_name=gmm${DIM}d_as_big" ;;
      esac
      echo "Lancement GMM ${V} K=${K} dim=${DIM} seed=${SEED}"
      python train.py ${ARGS} dim=${DIM} seed=${SEED} K=${K} num_epochs=${EPOCHS} \
          fast_sampling=true buffer_on_device=true fast_train=true \
          hydra.run.dir=results/gmm_as_mh/${V}_K${K}_dim${DIM}_seed${SEED} \
          > logs/${V}_K${K}_dim${DIM}_seed${SEED}.log 2>&1 &
      pids+=($!)
    done
  done
done

# Attend chaque processus et garde la trace des échecs
fail=0
for p in "${pids[@]}"; do wait "$p" || fail=1; done
kill $MON 2>/dev/null
echo "Fin à $(date), statut : ${fail}"
exit $fail
