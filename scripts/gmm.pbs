#!/bin/bash
#PBS -N gmm_asbs
#PBS -P gs_ccds_haidang.dau
#PBS -q gpu_as
#PBS -l walltime=18:00:00
#PBS -l select=1:ncpus=12:ngpus=1:mem=32gb
#PBS -J 0-3
#PBS -j oe

# Job array: 6 dimensions x 3 seeds = 18 sub-jobs, one GPU each.
# Submit once from the repo root with `qsub scripts/gmm.pbs`.
# Subset: e.g. `qsub -J 15-17 scripts/gmm.pbs` runs only dim 165 (indices 15,16,17).
DIMS=(3 8) # (3 8 16 39 80 165)
SEEDS=(0 1) # (0 1 2)
DIM=${DIMS[$((PBS_ARRAY_INDEX / ${#SEEDS[@]}))]}
SEED=${SEEDS[$((PBS_ARRAY_INDEX % ${#SEEDS[@]}))]}

cd "${PBS_O_WORKDIR}" || exit 1
export PYTHONUNBUFFERED=1

# --- Correctif officiel PBS/GaaS pour les identifiants GPU ---
if echo "${CUDA_VISIBLE_DEVICES:-}" | grep -q "GPU-"; then
    GPU_COUNT=$(echo "${CUDA_VISIBLE_DEVICES}" | tr ',' '\n' | wc -l)
    CUDA_VISIBLE_DEVICES=$(seq -s, 0 $((GPU_COUNT - 1)))
    export CUDA_VISIBLE_DEVICES
    echo "CUDA_VISIBLE_DEVICES converti en index : ${CUDA_VISIBLE_DEVICES}"
fi

# --- Optimisation CPU/MKL ---
export OMP_NUM_THREADS=12
export MKL_NUM_THREADS=12

# --- Chargement de l'environnement Conda BMS ---
module purge
module load anaconda/2025
eval "$(/usr/local/anaconda2025/bin/conda shell.bash hook)"
conda activate BMS

echo "Exécution sur le nœud : $(hostname) à $(date)"
nvidia-smi -L

# --- Lancement de l'expérience ---
# Relancer un sous-job reprend depuis le dernier checkpoint.
echo "GMM dim=${DIM} seed=${SEED} (index ${PBS_ARRAY_INDEX})"
python train.py experiment=gmm_asbs dim=${DIM} seed=${SEED} \
    hydra.run.dir=results/gmm/dim${DIM}_seed${SEED}
