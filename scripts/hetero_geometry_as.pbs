#!/bin/bash
#PBS -N hetero_geometry_as
#PBS -P gs_ccds_haidang.dau
#PBS -q gpu_as
#PBS -l walltime=03:00:00
#PBS -l select=1:ncpus=12:ngpus=1:mem=48gb
#PBS -j oe

# CHOIX DE LA GÉOMÉTRIE DE LA CIBLE HÉTÉROGÈNE, SUR AS SEUL (règle anti-surajustement : AUCUN run Barker n'est lancé ni lu ici).
# La géométrie initiale (rayons 7-11, échelles 0.6-1.6) fait s'effondrer AS (2-3 modes sur 24 trouvés) : trop difficile.
# Quatre géométries candidates, AS (réseau 256x6, config hetero_as), d = K = 24, graines 0 à 2, 2000 epochs : 12 runs.
# Règle fixée d'avance (scripts/hetero_geometry_rule.py), géométries parcourues dans l'ordre G1, G2, G3, G4 (de la moins difficile à
# la plus difficile) : la PREMIÈRE qui vérifie  quart léger moyen (3 graines) < 0.6  ET  modes_covered moyen >= 0.9  est retenue
# (la seconde condition écarte l'effondrement, où le quart léger n'a plus de sens). Si aucune : on étend la liste, toujours sur AS seul.
#   G1 rayons 4.5-6.5, rapport de poids 20 | G2 idem, rapport 100 | G3 rayons 5.5-8.0, rapport 20 | G4 idem, rapport 100
#   (échelles 0.6-1.4, min_sep 2.5 pour toutes)
DIM=24
COMMON="dim=${DIM} K=${DIM} num_epochs=2000 dump_final=true fast_sampling=true buffer_on_device=true fast_train=true scale_min=0.6 scale_max=1.4 min_sep=2.5"
declare -A GEOM=(
  [G1]="radius_min=4.5 radius_max=6.5 weight_ratio=20"
  [G2]="radius_min=4.5 radius_max=6.5 weight_ratio=100"
  [G3]="radius_min=5.5 radius_max=8.0 weight_ratio=20"
  [G4]="radius_min=5.5 radius_max=8.0 weight_ratio=100"
)

cd "${PBS_O_WORKDIR}" || exit 1
mkdir -p logs
export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1

# --- Correctif officiel PBS/GaaS pour les identifiants GPU (inchangé) ---
if echo "${CUDA_VISIBLE_DEVICES:-}" | grep -q "GPU-"; then
    GPU_COUNT=$(echo "${CUDA_VISIBLE_DEVICES}" | tr ',' '\n' | wc -l)
    CUDA_VISIBLE_DEVICES=$(seq -s, 0 $((GPU_COUNT - 1)))
    export CUDA_VISIBLE_DEVICES
fi

module purge
module load anaconda/2025
eval "$(/usr/local/anaconda2025/bin/conda shell.bash hook)"
conda activate BMS

echo "Nœud : $(hostname) à $(date)"
nvidia-smi -L
git log --oneline -1

pids=()
for G in G1 G2 G3 G4; do
  for SEED in 0 1 2; do
    python train.py experiment=hetero_as ${COMMON} ${GEOM[$G]} seed=${SEED} exp_name=hetero24d_geom${G}_as \
        hydra.run.dir=results/hetero_geometry/${G}_as_seed${SEED} > logs/hetero_geom_${G}_as_seed${SEED}.log 2>&1 &
    pids+=($!)
  done
done
fail=0
for p in "${pids[@]}"; do wait "$p" || fail=1; done
echo "Fin à $(date), statut : ${fail}"
exit $fail
