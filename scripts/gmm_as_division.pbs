#!/bin/bash
#PBS -N gmm_division
#PBS -P gs_ccds_haidang.dau
#PBS -q gpu_as
#PBS -l walltime=08:00:00
#PBS -l select=1:ncpus=6:ngpus=1:mem=32gb
#PBS -j oe

# NOUVEAU run (le précédent, commit a8e0c53, reste « échec numérique » : NaN à t = 0 exactement, corrigé en e6aa459), mêmes règles pré-enregistrées et règle de validité. UN run : AS + variable de contrôle par DIVISION (AdjointVEDivisionMatcher), d = K = 36, graine 0, cible GMM isotrope figée (spread, rayon 4.25), gros contrôleur
# 256x6, 2000 epochs, gamma = 1 après l'échauffement (première version des paramètres). Mêmes drapeaux, mêmes évaluations (toutes les 50 epochs, 10 000 échantillons) que les cellules AS-big et
# Barker-gamma3-big du balayage de capacité (scripts/gmm_as_capacity.pbs). Critères pré-enregistrés : scripts/analyse_division_gmm.py (engagés dans git avant la soumission).
EPOCHS=2000
BIG="controller.channels=256 controller.num_layers=6"
COMMON="num_epochs=${EPOCHS} dump_final=true fast_sampling=true buffer_on_device=true fast_train=true ${BIG}"

cd "${PBS_O_WORKDIR}" || exit 1
mkdir -p logs
export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1

# --- Correctif officiel PBS/GaaS pour les identifiants GPU (inchangé) ---
if echo "${CUDA_VISIBLE_DEVICES:-}" | grep -q "GPU-"; then
    GPU_COUNT=$(echo "${CUDA_VISIBLE_DEVICES}" | tr ',' '\n' | wc -l)
    CUDA_VISIBLE_DEVICES=$(seq -s, 0 $((GPU_COUNT - 1)))
    export CUDA_VISIBLE_DEVICES
fi

module purge
module load anaconda/2025
eval "$(/usr/local/anaconda2025/bin/conda shell.bash hook)"
conda activate BMS

echo "Nœud : $(hostname) à $(date)"
nvidia-smi -L
git log --oneline -1

python train.py experiment=gmm_as_division dim=36 K=36 seed=0 ${COMMON} \
    exp_name=gmm36d_as_division \
    hydra.run.dir=results/gmm_as_division/seed0_t0fix \
    > logs/gmm_as_division_seed0_t0fix.log 2>&1
fail=$?
python scripts/analyse_division_gmm.py --commit $(git rev-parse --short HEAD) || fail=1
echo "Fin à $(date), statut : ${fail}"
exit $fail
