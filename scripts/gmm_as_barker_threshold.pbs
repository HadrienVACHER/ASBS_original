#!/bin/bash
#PBS -N gmm_as_barker_threshold
#PBS -P gs_ccds_haidang.dau
#PBS -q gpu_as
#PBS -l walltime=06:00:00
#PBS -l select=1:ncpus=6:ngpus=1:mem=24gb
#PBS -j oe

# GO / NO-GO des centres par seuil (À lancer depuis la branche mh). Barker gamma = 2, seed 0, 2000 epochs, dump_final.
#   d = 36 : centres threshold
#   d = 24 : centres threshold + oracle + k-means (comparateurs à gamma = 2, qui n'existaient pas à d = 24)
# Comparateurs d = 36 à gamma = 2 (déjà dans W&B) : gmm36d_as_barker_g2_km (bv1o72bm), gmm36d_as_barker_g2_oracle (1sk5okqr).
# Critères (métriques moyennées sur les 30 dernières évaluations) :
#   d = 24 : min R >= 0.35 et moyenne |log R| <= 0.23   (oracle gamma=1 : 0.46 / 0.209 ; k-means : 0.11-0.14 / 0.25-0.29)
#   d = 36 : moyenne |log R| <= 0.27 sans pire mode sous 0.15   (oracle gamma=2 : 0.252 ; k-means gamma=2 : 0.317)
#   et barker/centre_coverage >= 0.99, barker/centres_spurious ~ 0 à chaque epoch
CONFIGS=(36:2:thr 24:2:thr 24:2:oracle 24:2:km)
SEED=0
EPOCHS=2000
NPROC=${#CONFIGS[@]}
THREADS=$(( 6 / NPROC > 0 ? 6 / NPROC : 1 ))

cd "${PBS_O_WORKDIR}" || exit 1
mkdir -p logs
export PYTHONUNBUFFERED=1

# --- Correctif officiel PBS/GaaS pour les identifiants GPU (inchangé) ---
if echo "${CUDA_VISIBLE_DEVICES:-}" | grep -q "GPU-"; then
    GPU_COUNT=$(echo "${CUDA_VISIBLE_DEVICES}" | tr ',' '\n' | wc -l)
    CUDA_VISIBLE_DEVICES=$(seq -s, 0 $((GPU_COUNT - 1)))
    export CUDA_VISIBLE_DEVICES
fi

export OMP_NUM_THREADS=${THREADS}
export MKL_NUM_THREADS=${THREADS}

module purge
module load anaconda/2025
eval "$(/usr/local/anaconda2025/bin/conda shell.bash hook)"
conda activate BMS

echo "Nœud : $(hostname) à $(date)"
nvidia-smi -L
git log --oneline -1

pids=()
for CFG in "${CONFIGS[@]}"; do
  IFS=: read -r DIM G C <<< "${CFG}"
  case ${C} in
    thr)    EXTRA="adjoint_matcher.centre_method=threshold" ;;
    oracle) EXTRA="adjoint_matcher.centre_method=oracle" ;;
    km)     EXTRA="" ;;
  esac
  echo "Lancement Barker K=${DIM} dim=${DIM} gamma=${G} centres=${C}"
  python train.py experiment=gmm_as_barker dim=${DIM} K=${DIM} seed=${SEED} num_epochs=${EPOCHS} \
      adjoint_matcher.gamma=${G} ${EXTRA} dump_final=true \
      fast_sampling=true buffer_on_device=true fast_train=true \
      exp_name=gmm${DIM}d_as_barker_g${G}_${C} \
      hydra.run.dir=results/gmm_as_barker_threshold/K${DIM}_g${G}_${C}_seed${SEED} \
      > logs/barker_threshold_K${DIM}_g${G}_${C}_seed${SEED}.log 2>&1 &
  pids+=($!)
done

# Attend chaque processus et garde la trace des échecs
fail=0
for p in "${pids[@]}"; do wait "$p" || fail=1; done
echo "Fin à $(date), statut : ${fail}"
exit $fail
