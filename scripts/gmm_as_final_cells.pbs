#!/bin/bash
#PBS -N gmm_as_final_cells
#PBS -P gs_ccds_haidang.dau
#PBS -q gpu_as
#PBS -l walltime=06:00:00
#PBS -l select=1:ncpus=9:ngpus=1:mem=48gb
#PBS -j oe

# Cases manquantes de la figure finale du GMM (À lancer depuis la branche mh), graines 0 à 2, 2000 epochs, dump_final :
#   d = 24 : AS gros, Barker gamma = 3 gros     (6 runs)
#   d = 36 : Barker gamma = 3 gros              (3 runs)   <- la méthode gelée (gamma = 3, centres seuil, réseau 256x6)
# Les autres cases viennent des jobs des graines et de la capacité. Les noms W&B suivent les motifs de plot_gmm_final.py.
cd "${PBS_O_WORKDIR}" || exit 1
mkdir -p logs
export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1

# --- Correctif officiel PBS/GaaS pour les identifiants GPU (inchangé) ---
if echo "${CUDA_VISIBLE_DEVICES:-}" | grep -q "GPU-"; then
    GPU_COUNT=$(echo "${CUDA_VISIBLE_DEVICES}" | tr ',' '\n' | wc -l)
    CUDA_VISIBLE_DEVICES=$(seq -s, 0 $((GPU_COUNT - 1)))
    export CUDA_VISIBLE_DEVICES
fi

module purge
module load anaconda/2025
eval "$(/usr/local/anaconda2025/bin/conda shell.bash hook)"
conda activate BMS

echo "Nœud : $(hostname) à $(date)"
nvidia-smi -L
git log --oneline -1

COMMON="num_epochs=2000 dump_final=true fast_sampling=true buffer_on_device=true fast_train=true"
pids=()
for SEED in 0 1 2; do
  python train.py experiment=gmm_as_final dim=24 K=24 seed=${SEED} ${COMMON} exp_name=gmm24d_as_big_cap \
      hydra.run.dir=results/gmm_final_cells/as_big_d24_seed${SEED} > logs/final_as_big_d24_seed${SEED}.log 2>&1 &
  pids+=($!)
  python train.py experiment=gmm_as_barker_final dim=24 K=24 seed=${SEED} ${COMMON} exp_name=gmm24d_as_barker_g3_thr_big \
      hydra.run.dir=results/gmm_final_cells/barker_big_d24_seed${SEED} > logs/final_barker_big_d24_seed${SEED}.log 2>&1 &
  pids+=($!)
  python train.py experiment=gmm_as_barker_final dim=36 K=36 seed=${SEED} ${COMMON} exp_name=gmm36d_as_barker_g3_thr_big \
      hydra.run.dir=results/gmm_final_cells/barker_big_d36_seed${SEED} > logs/final_barker_big_d36_seed${SEED}.log 2>&1 &
  pids+=($!)
done
fail=0
for p in "${pids[@]}"; do wait "$p" || fail=1; done
echo "Fin à $(date), statut : ${fail}"
exit $fail
