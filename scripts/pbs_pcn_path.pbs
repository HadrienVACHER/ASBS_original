#!/bin/bash
#PBS -N pcn_path
#PBS -P gs_ccds_haidang.dau
#PBS -q gpu_as
#PBS -l walltime=01:00:00
#PBS -l select=1:ncpus=4:ngpus=1:mem=32gb
#PBS -j oe
# rules/rules_pcn_path.md (PHASE 2, prepared, NOT to be submitted before the rules are frozen). Controllers are versioned in figures/gmmdk_step4/controllers.
cd "${PBS_O_WORKDIR:-.}" || exit 1
export PYTHONUNBUFFERED=1
if echo "${CUDA_VISIBLE_DEVICES:-}" | grep -q "GPU-"; then export CUDA_VISIBLE_DEVICES=0; fi
module purge; module load anaconda/2025; eval "$(/usr/local/anaconda2025/bin/conda shell.bash hook)"; conda activate BMS
git log --oneline -1
for e in 1000 1250 1500; do for rho in 0.0 0.9 0.99 0.999; do python scripts/pcn_path.py $e $rho || exit 1; done; done
