#!/bin/bash
#PBS -N gmm_as_capacity
#PBS -P gs_ccds_haidang.dau
#PBS -q gpu_as
#PBS -l walltime=08:00:00
#PBS -l select=1:ncpus=6:ngpus=1:mem=32gb
#PBS -j oe

# Ablation de capacité à d = 36 (À lancer depuis la branche mh) : AS et Barker-seuil (gamma = 2) avec le gros contrôleur
# (256 canaux x 6 couches, au lieu de 128 x 4), seeds 0 à 2, 2000 epochs, dump_final : 6 runs. Les cases petit réseau du 2x2
# viennent du job des graines (gmm36d_as_cmp et gmm36d_as_barker_g2_thr). Largeur et profondeur ne sont pas séparées.
# Analyse : python scripts/analyse_capacity.py (courbes de |log R| et du pire mode contre les epochs et contre les appels d'énergie).
SEEDS=(0 1 2)
EPOCHS=2000
BIG="controller.channels=256 controller.num_layers=6"
COMMON="num_epochs=${EPOCHS} dump_final=true fast_sampling=true buffer_on_device=true fast_train=true ${BIG}"

cd "${PBS_O_WORKDIR}" || exit 1
mkdir -p logs
export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1

# --- Correctif officiel PBS/GaaS pour les identifiants GPU (inchangé) ---
if echo "${CUDA_VISIBLE_DEVICES:-}" | grep -q "GPU-"; then
    GPU_COUNT=$(echo "${CUDA_VISIBLE_DEVICES}" | tr ',' '\n' | wc -l)
    CUDA_VISIBLE_DEVICES=$(seq -s, 0 $((GPU_COUNT - 1)))
    export CUDA_VISIBLE_DEVICES
fi

module purge
module load anaconda/2025
eval "$(/usr/local/anaconda2025/bin/conda shell.bash hook)"
conda activate BMS

echo "Nœud : $(hostname) à $(date)"
nvidia-smi -L
git log --oneline -1

pids=()
for SEED in "${SEEDS[@]}"; do
  echo "Lancement AS-big et Barker-seuil-big K=36 seed=${SEED}"
  python train.py experiment=gmm_as dim=36 K=36 seed=${SEED} ${COMMON} \
      exp_name=gmm36d_as_big_cap \
      hydra.run.dir=results/gmm_as_capacity/as_big_seed${SEED} \
      > logs/cap_as_big_seed${SEED}.log 2>&1 &
  pids+=($!)
  python train.py experiment=gmm_as_barker dim=36 K=36 seed=${SEED} ${COMMON} \
      adjoint_matcher.gamma=2 adjoint_matcher.centre_method=threshold \
      exp_name=gmm36d_as_barker_g2_thr_big \
      hydra.run.dir=results/gmm_as_capacity/barker_thr_big_seed${SEED} \
      > logs/cap_barker_thr_big_seed${SEED}.log 2>&1 &
  pids+=($!)
done

fail=0
for p in "${pids[@]}"; do wait "$p" || fail=1; done
echo "Fin à $(date), statut : ${fail}"
exit $fail
