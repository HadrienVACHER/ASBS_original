#!/bin/bash
#PBS -N imh_fit_sweep
#PBS -P gs_ccds_haidang.dau
#PBS -q gpu_as
#PBS -l walltime=03:00:00
#PBS -l select=1:ncpus=4:ngpus=1:mem=16gb
#PBS -j oe

# Sweep of the fitted proposal r of scripts/imh_fitted_gmm.py at K = d: covariance family x inflate x denoise.
# One W&B run each (--wandb), one log each in logs/imh_sweep_<jobid>/, and a summary of the last fitted-chain step at the end.
#   qsub scripts/imh_fitted_gmm_sweep.pbs
DIMS=(12 24 36)
COVS=(full tied spherical)
INFLATES=(1.0 1.2)
DENOISES=("" "--denoise")

cd "${PBS_O_WORKDIR}" || exit 1
export PYTHONUNBUFFERED=1
OUT=logs/imh_sweep_${PBS_JOBID%%.*}
mkdir -p "${OUT}"

# --- Correctif officiel PBS/GaaS pour les identifiants GPU (inchangé) ---
if echo "${CUDA_VISIBLE_DEVICES:-}" | grep -q "GPU-"; then
    GPU_COUNT=$(echo "${CUDA_VISIBLE_DEVICES}" | tr ',' '\n' | wc -l)
    CUDA_VISIBLE_DEVICES=$(seq -s, 0 $((GPU_COUNT - 1)))
    export CUDA_VISIBLE_DEVICES
fi

export OMP_NUM_THREADS=4
export MKL_NUM_THREADS=4

module purge
module load anaconda/2025
eval "$(/usr/local/anaconda2025/bin/conda shell.bash hook)"
conda activate BMS

echo "Nœud : $(hostname) à $(date)"
nvidia-smi -L

fail=0
for DIM in "${DIMS[@]}"; do
  for COV in "${COVS[@]}"; do
    for INF in "${INFLATES[@]}"; do
      for DN in "${DENOISES[@]}"; do
        TAG="d${DIM}_${COV}_i${INF}_$([ -n "${DN}" ] && echo dn || echo nodn)"
        python scripts/imh_fitted_gmm.py --dim ${DIM} --K ${DIM} --cov ${COV} --inflate ${INF} ${DN} --wandb \
            > "${OUT}/${TAG}.log" 2>&1 || { echo "FAILED ${TAG}"; fail=1; }
      done
    done
  done
done

echo
echo "=== last step of the fitted chain (accept, mode_tv, energy_w2) and the covariance eigenvalues"
for f in "${OUT}"/*.log; do
  echo "$(basename ${f%.log})  $(grep -E 'eigenvalues' ${f} | sed 's/.*eigenvalues of the covariances //')"
  grep -A8 'chain, fitted r' "${f}" | grep 'step  300' | sed 's/^ */    /' | cut -c1-120
done
echo "Fin à $(date), statut : ${fail}"
exit $fail
