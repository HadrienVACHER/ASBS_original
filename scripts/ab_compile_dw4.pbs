#!/bin/bash
#PBS -N ab_compile
#PBS -P gs_ccds_haidang.dau
#PBS -q gpu_as
#PBS -l walltime=01:00:00
#PBS -l select=1:ncpus=3:ngpus=1:mem=16gb
#PBS -j oe

# A/B court de torch.compile (mode reduce-overhead = graphes CUDA du pas d'entraînement) sur DW-4, même graine : A = fast_train par défaut, A' = répétition de A (bruit de référence),
# B = fast_train + compile_mode=reduce-overhead. 60 epochs, nfe 100, sampling classique pour les trois (on isole le pas d'entraînement). Les recompilations / ruptures de graphe sont
# comptées via TORCH_LOGS. Rapport : python scripts/ab_compile_report.py. A ne pas adopter reduce-overhead avant d'avoir lu ce rapport.
cd "${PBS_O_WORKDIR}" || exit 1
mkdir -p logs data
export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1

# --- Correctif officiel PBS/GaaS pour les identifiants GPU (inchangé) ---
if echo "${CUDA_VISIBLE_DEVICES:-}" | grep -q "GPU-"; then
    GPU_COUNT=$(echo "${CUDA_VISIBLE_DEVICES}" | tr ',' '\n' | wc -l)
    CUDA_VISIBLE_DEVICES=$(seq -s, 0 $((GPU_COUNT - 1)))
    export CUDA_VISIBLE_DEVICES
fi

module purge
module load anaconda/2025
eval "$(/usr/local/anaconda2025/bin/conda shell.bash hook)"
conda activate BMS

echo "Nœud : $(hostname) à $(date)"
nvidia-smi -L
git log --oneline -1

if [ ! -f data/test_split_DW4.npy ]; then bash scripts/download.sh; fi
export TORCH_LOGS="recompiles,graph_breaks"
COMMON="experiment=dw4_as_states seed=0 num_epochs=60 nfe=100 eval_freq=30 project=as buffer_on_device=true fast_train=true fast_sampling=false"
python train.py ${COMMON} exp_name=ab_compile_A  hydra.run.dir=results/ab_compile/A  > logs/ab_compile_A.log 2>&1
python train.py ${COMMON} exp_name=ab_compile_A2 hydra.run.dir=results/ab_compile/A2 > logs/ab_compile_A2.log 2>&1
python train.py ${COMMON} compile_mode=reduce-overhead exp_name=ab_compile_B hydra.run.dir=results/ab_compile/B > logs/ab_compile_B.log 2>&1
fail=0
python scripts/ab_compile_report.py || fail=1
echo "Fin à $(date), statut : ${fail}"
exit $fail
