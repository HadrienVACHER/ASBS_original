#!/bin/bash
#PBS -N smc_noise
#PBS -P gs_ccds_haidang.dau
#PBS -q gpu_as
#PBS -l walltime=06:00:00
#PBS -l select=1:ncpus=8:ngpus=1:mem=48gb
#PBS -j oe

# rules/rules_smc_noise.md (stage 1) and rules/rules_pcn_path.md (frozen by the amendment of 2026-11-27). All inputs are versioned. At most MAXJ processes on the one GPU.
# A job whose output JSON exists is skipped (resubmit after a walltime stop). Options: MAXJ (default 3), DRY=1 (print only), SMOKE=1 (environment / GPU / paths check only, < 5 min).
cd "${PBS_O_WORKDIR:-.}" || exit 1
mkdir -p logs figures/smc_noise results/smc_noise
rm -f logs/smc_smoke.OK logs/smc_smoke.FAIL
export PYTHONUNBUFFERED=1 OMP_NUM_THREADS=2 MKL_NUM_THREADS=2 MPLBACKEND=Agg
MAXJ=${MAXJ:-3}; DRY=${DRY:-0}
if echo "${CUDA_VISIBLE_DEVICES:-}" | grep -q "GPU-"; then export CUDA_VISIBLE_DEVICES=0; fi
if [ "$DRY" != 1 ]; then
  module purge; module load anaconda/2025; eval "$(/usr/local/anaconda2025/bin/conda shell.bash hook)"; conda activate BMS
  echo "Noeud : $(hostname) a $(date)"; nvidia-smi -L; git log --oneline -1
fi
if [ "${SMOKE:-0}" = 1 ]; then
  rm -f figures/smc_noise/smoke.json
  if [ "$DRY" = 1 ]; then echo "python scripts/smc_noise.py smoke"; exit 0; fi
  timeout 290 python scripts/smc_noise.py smoke > logs/smc_smoke.log 2>&1; rc=$?
  tail -n 5 logs/smc_smoke.log
  if [ $rc = 0 ] && [ -f figures/smc_noise/smoke.json ]; then echo "FUMEE REUSSIE $(date)" | tee logs/smc_smoke.OK; else echo "FUMEE ECHOUEE (code $rc), voir logs/smc_smoke.log" | tee logs/smc_smoke.FAIL; fi
  exit $rc
fi
JOBS=()
for c in "A 1000" "A 1250" "A 1500" "B 1000" "B 1250" "B 1500" "C 250" "C 500" "C 750"; do
  for r in 0 1 2; do set -- $c; JOBS+=("figures/smc_noise/run_${1}_ep${2}_r${r}.json|run $1 $2 $r"); done
done
for e in 1000 1250 1500; do for rho in 0.0 0.9 0.99 0.999; do JOBS+=("figures/smc_noise/pcn_ep${e}_rho${rho}.json|pcn B $e --rho $rho"); done; done
run() { out=${1%%|*}; args=${1#*|}; tag=$(echo $args | tr ' ' '_')
  [ -f "$out" ] && { echo "deja fait : $tag"; return; }
  if [ "$DRY" = 1 ]; then echo "python scripts/smc_noise.py $args"; return; fi
  echo "lancement $tag $(date +%H:%M:%S)"; python scripts/smc_noise.py $args > logs/smc_$tag.log 2>&1 || { echo "ECHEC $tag (logs/smc_$tag.log)"; return 1; }; echo "fini $tag $(date +%H:%M:%S)"; }
pids=()
for j in "${JOBS[@]}"; do
  while [ "$(jobs -rp | wc -l)" -ge "$MAXJ" ]; do sleep 10; done
  run "$j" & pids+=($!); [ "$DRY" = 1 ] || sleep 2
done
fail=0; for p in "${pids[@]}"; do wait "$p" || fail=1; done
if [ "$DRY" != 1 ] && [ $fail = 0 ]; then tar czf smc_noise_results.tar.gz figures/smc_noise results/smc_noise logs/smc_*.log && ls -la smc_noise_results.tar.gz; fi
echo "Fin a $(date), statut : $fail"; exit $fail
